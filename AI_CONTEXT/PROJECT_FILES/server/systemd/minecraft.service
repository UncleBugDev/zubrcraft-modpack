[Unit]
Description=Minecraft Forge 1.20.1 Server (ZubrCraft)
After=network.target

[Service]
Type=forking
User=unclebug
Group=unclebug
WorkingDirectory=/home/unclebug/storage/minecraft
ExecStart=/usr/bin/screen -dmS minecraft /home/unclebug/storage/minecraft/run.sh
ExecStop=/usr/bin/screen -p 0 -S minecraft -X eval 'stuff "stop\015"'
Restart=always
RestartSec=10s
TimeoutStopSec=60s

[Install]
WantedBy=multi-user.target
